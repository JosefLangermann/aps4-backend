# Copie este arquivo para ".env" (cp .env.example .env) e ajuste os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Chave usada para assinar os tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazia, a API usa uma chave aleatória temporária (os tokens expiram ao reiniciar).
JWT_SECRET_KEY=

# Validade do token, em minutos (padrão: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Administrador inicial, criado automaticamente ao subir a API (se o e-mail ainda não existir).
# Valores de exemplo para uso local: TROQUE antes de usar em qualquer ambiente real.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=Admin@12345
